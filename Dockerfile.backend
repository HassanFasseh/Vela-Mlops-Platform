FROM python:3.12-slim

WORKDIR /app

COPY backend/app/requirements.txt ./backend/app/requirements.txt
RUN pip install --no-cache-dir -r backend/app/requirements.txt

COPY backend/ ./backend/

# GET /api/v1/custom-model-template (backend/app/main.py) reads this file
# straight off disk at request time — it has to exist in the image, not
# just in the repo checkout used for local dev.
COPY custom-runner/predict_template.py ./custom-runner/predict_template.py

EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
